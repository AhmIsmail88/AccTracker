rules_version = '2';
// قواعد Storage — AccTracker: أي مستخدم موثّق يرفع الحزم (حتى 200 ميجا) ويقرأها.
service firebase.storage {
  match /b/{bucket}/o {
    match /packages/{deviceId}/{fileName} {
      allow write: if request.auth != null
                   && request.resource.size < 200 * 1024 * 1024;
      allow read: if request.auth != null;
    }
  }
}
